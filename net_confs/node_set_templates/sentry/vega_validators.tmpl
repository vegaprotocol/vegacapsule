{{- $tm_port_base := 26000 -}}
{{- $tm_proxy_port := add $tm_port_base 100 .NodeNumber -}}
{{- $tm_rpc_port := add $tm_port_base 200 .NodeNumber -}}

{{- $port_base := 3000 -}}

[Admin]
  [Admin.Server]
    SocketPath = "/tmp/vega-{{.NodeNumber}}.sock"
    Enabled = true

[API]
	Port = 30{{.NodeNumber}}2
	[API.REST]
			Port = 30{{.NodeNumber}}3

[Blockchain]
	[Blockchain.Tendermint]
		RPCAddr = "tcp://127.0.0.1:{{$tm_rpc_port}}"
	[Blockchain.Null]
		Port = 31{{.NodeNumber}}1

[EvtForward]
	Level = "Info"
	RetryRate = "1s"
	{{if .FaucetPublicKey}}
	BlockchainQueueAllowlist = ["{{ .FaucetPublicKey }}"]
	{{end}}
    [[EvtForward.EVMBridges]]
      Level = "Info"
      PollEventRetryDuration = "500ms"
      ChainID = "{{.SecondaryBridgeC
	  SkipClientVerification = true
    [EvtForward.Ethereum]
        SkipClientVerification = true


[Ethereum]
  RPCEndpoint = "{{.ETHEndpoint}}"
  [[Ethereum.EVMBridgeConfigs]]
    RPCEndpoint = "{{.SecondaryETHEndpoint}}"
    ChainID = "{{.SecondaryBridgeChainID}}"

[Processor]
	[Processor.Ratelimit]
		Requests = 10000
		PerNBlocks = 1
